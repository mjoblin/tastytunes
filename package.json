{
  "name": "tastytunes",
  "version": "0.1.0",
  "description": "A desktop controller for Cambridge Audio StreamMagic streamers. A bigger, tastier serving than PunyTunes.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mjoblin/tastytunes.git"
  },
  "homepage": "https://github.com/mjoblin/tastytunes",
  "main": "./out/main/index.js",
  "type": "module",
  "author": "Mike",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/sora": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@fontsource-variable/unbounded": "^5.2.8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^4.5.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/bricolage-grotesque": "^5.1.0",
    "@fontsource-variable/instrument-sans": "^5.1.0",
    "@fontsource/spline-sans-mono": "^5.1.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^3.0.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "zustand": "^5.0.0"
  }
}
