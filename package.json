{
  "name": "tastytunes",
  "version": "0.5.0-rc.1",
  "description": "A desktop controller for Cambridge Audio StreamMagic streamers.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mjoblin/tastytunes.git"
  },
  "homepage": "https://github.com/mjoblin/tastytunes",
  "main": "./out/main/index.js",
  "type": "module",
  "author": "Redacted Cat",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && node scripts/build-win.mjs",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.2.8",
    "@fontsource/instrument-serif": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^4.5.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/instrument-sans": "^5.1.0",
    "@fontsource/spline-sans-mono": "^5.1.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^3.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lucide-react": "^0.475.0",
    "prettier": "3.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0",
    "zustand": "^5.0.0"
  }
}
