{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "declaration": false,
    "outDir": "dist",
    "skipLibCheck": true
  },
  "include": ["src/**/*", "../src/shared/**/*"]
}
